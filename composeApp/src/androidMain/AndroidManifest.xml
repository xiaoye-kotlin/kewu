<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 上传录音要访问后端服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 录音权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 扫码签到：相机权限 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 线性马达震动反馈（全 app 点击 / 导航 / 登录成功）。缺失会导致 Vibrator.vibrate 抛 SecurityException 崩溃 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 录音前台服务（2026-10-26）：锁屏 / 后台继续录课堂录音；Android 14 需声明 microphone 类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 通知（Android 13+ 运行时权限，通知设置页引导申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="课悟"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Kewu">

        <!-- adjustResize：窗口随键盘收缩，Compose weight 区自动让位（adjustPan 默认会把整页顶上去）。
             configChanges（2026-10-19 加）：旋屏 / 字体缩放 / 暗色模式 / 分屏等配置变更不再重建
             Activity，由 Compose 自行重组（LocalConfiguration 自动更新）——全 app 各页面的
             remember 状态（登录表单、聊天记录、录音状态机等）在旋屏后原样保留。
             修用户报的「首页录音中旋屏，回来录音就结束了」：旧行为 Activity 重建 →
             Composition 销毁 → UI 状态归零（麦克风还在后台录，见 RecordingManager 注释）。
             未覆盖的变更（如系统语言切换）仍会重建，属可接受边缘场景。 -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|colorMode|locale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
